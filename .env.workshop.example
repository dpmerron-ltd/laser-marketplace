# Copy to .env.workshop on the workshop computer. Never commit real credentials.
# Shopify Admin API app installed on this store, with read_orders access.
LASER_SHOPIFY_SHOP=

# Choose one authentication method. An access token takes precedence if both are set.
LASER_SHOPIFY_ACCESS_TOKEN=

# For an app and store in the same Shopify organization; tokens refresh automatically.
LASER_SHOPIFY_CLIENT_ID=
LASER_SHOPIFY_CLIENT_SECRET=

LASER_SHOPIFY_POLL_SECONDS=60
# Optional local service settings:
# LASER_WORKSHOP_PORT=4318
# LASER_WORKSHOP_DATA=/absolute/path/to/workshop-data
